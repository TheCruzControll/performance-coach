{
	"name": "performance-coach",
	"version": "0.1.0",
	"private": true,
	"description": "Private, single-user AI performance coaching platform (coach.nikocruz.com).",
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.19 <23"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:vercel": "ADAPTER=vercel vite build",
		"build:node": "ADAPTER=node vite build",
		"build:all": "pnpm build:vercel && pnpm build:node",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:setup": "bash scripts/db-setup.sh",
		"db:generate": "drizzle-kit generate",
		"db:drift": "drizzle-kit generate && git diff --exit-code --stat -- drizzle && test -z \"$(git status --porcelain -- drizzle)\"",
		"db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
		"db:reset:test": "node --env-file-if-exists=.env scripts/db-reset.ts --target test",
		"db:reset:e2e": "node --env-file-if-exists=.env scripts/db-reset.ts --target e2e",
		"db:explain": "vitest run --project explain",
		"db:studio": "drizzle-kit studio",
		"test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:live": "vitest run --project live",
		"test:e2e": "playwright test",
		"test:e2e:deployed": "E2E_DEPLOYED_LOCAL=1 playwright test",
		"e2e:timings": "node scripts/e2e-timings.ts",
		"auth:setup-token": "node scripts/auth-setup-token.ts",
		"auth:reset-owner": "node scripts/auth-reset-owner.ts",
		"backup:run": "node scripts/backup-run.ts",
		"backup:list": "node scripts/backup-list.ts",
		"backup:keygen": "node scripts/backup-keygen.ts",
		"backup:restore": "node scripts/backup-restore.ts",
		"budgets": "node scripts/check-budgets.ts",
		"docs:prs": "node scripts/docs-prs.ts",
		"lighthouse": "node scripts/lighthouse.ts",
		"icons": "node scripts/generate-icons.ts",
		"icons:sprite": "node scripts/generate-icon-sprite.ts",
		"lifecycles": "node scripts/lifecycles.ts",
		"security:scan": "node scripts/secrets-scan.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "1.6.0",
		"@simplewebauthn/server": "^14.0.3",
		"@vercel/blob": "2.8.2",
		"@vercel/functions": "^3.10.6",
		"drizzle-orm": "^0.45.4",
		"idb": "^8.0.4",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/hubot-sans": "^5.3.0",
		"@fontsource-variable/mona-sans": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@neon/config": "^1.11.3",
		"@playwright/test": "1.63.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"chrome-launcher": "^1.2.2",
		"devalue": "5.9.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"fake-indexeddb": "^6.2.6",
		"globals": "^17.14.0",
		"lighthouse": "^13.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"web-vitals": "^6.2.3"
	}
}
