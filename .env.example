# Performance Coach — environment variables. Copy to `.env` for local development:
#   cp .env.example .env
# Every variable is validated at startup by src/lib/server/env.ts. See docs/environment.md.

# Environment name: development | test | preview | production.
# Optional — derived from VERCEL_ENV / NODE_ENV when unset.
APP_ENV=development

# Pooled connection for application traffic (Neon: the `-pooler` host in production).
DATABASE_URL=postgres://coach:coach@localhost:5432/coach_dev
# Direct, non-pooled connection used by migrations and backups.
DATABASE_URL_UNPOOLED=postgres://coach:coach@localhost:5432/coach_dev

# Disposable databases for automated tests (names must end in _test / _e2e).
TEST_DATABASE_URL=postgres://coach:coach@localhost:5432/coach_test
E2E_DATABASE_URL=postgres://coach:coach@localhost:5432/coach_e2e

# Pool tuning (per server instance).
DB_POOL_MAX=5
DB_QUERY_TIMEOUT_MS=10000

# debug | info | warn | error | silent
LOG_LEVEL=info

# First-run owner setup: hex SHA-256 of the one-time setup token. `pnpm auth:setup-token
# --origin http://localhost:5173` prints a token, this hash and the /setup link. Unset = no setup.
OWNER_SETUP_TOKEN_HASH=

# Test-only routes (an intentional 500; a session minted without a passkey for WebKit e2e).
# Refused by env validation on any hosted deployment (Vercel, preview, production).
ENABLE_TEST_ROUTES=false

# Coach LLM provider (Milestone 5). `mock` is deterministic and needs no key.
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=

# Optional error reporting; leave empty (no account required).
SENTRY_DSN=

# Email sign-in link (ADR 0011): off unless OWNER_EMAIL and, outside test servers, RESEND_API_KEY
# are set. Never stops the server: the startup log names a missing or invalid one. With test
# routes on, mail goes to a recording test provider, never to Resend. Never commit a real
# address. Hosted deployments: docs/deployment.md → "Email sign-in link".
# OWNER_EMAIL=owner@example.test
# RESEND_API_KEY=re_example_not_a_real_key
# Optional sender, an address or `Name <address>`. Default: Resend's onboarding address.
# EMAIL_FROM=Performance Coach <coach@example.test>

# adapter-node builds served over plain HTTP: the public origin is baked in at BUILD time
# (WebAuthn origin, CSRF checks, cookie flags), e.g. ORIGIN=http://localhost:4173 pnpm build:node
# ORIGIN=http://localhost:4173
