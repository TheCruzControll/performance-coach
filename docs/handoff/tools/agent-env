#!/usr/bin/env bash
# Prepare an isolated environment for one agent's slice, run from inside its git worktree:
#
#   agent-env <slug> <port>
#
# - installs this worktree's own node_modules (SvelteKit writes generated types into them),
# - creates the slice's own Postgres databases coach_<slug>_{dev,test,e2e} and migrates dev,
# - writes $SCRATCH/env/<slug>.sh, which every later command must source:
#       source "$SCRATCH/env/<slug>.sh" && pnpm test:integration
set -euo pipefail
slug="${1:?usage: agent-env <slug> <port>}"
port="${2:?usage: agent-env <slug> <port>}"
[[ "$slug" =~ ^[a-z0-9]+$ ]] || { echo "agent-env: slug must be [a-z0-9]+" >&2; exit 2; }
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRATCH="$(dirname "$BIN")"
mkdir -p "$SCRATCH/env"
envfile="$SCRATCH/env/$slug.sh"
db="postgres://coach:coach@localhost:5432/coach_${slug}"
cat >"$envfile" <<EOF
# Environment for slice '$slug' (generated by agent-env). Source before every command.
if [ -s "\$HOME/.nvm/nvm.sh" ]; then export NVM_DIR="\$HOME/.nvm"; . "\$NVM_DIR/nvm.sh" >/dev/null 2>&1; nvm use 22 >/dev/null 2>&1 || true; fi
export PATH="$BIN:\$PATH"
export APP_ENV=development
export DATABASE_URL=${db}_dev DATABASE_URL_UNPOOLED=${db}_dev
export TEST_DATABASE_URL=${db}_test E2E_DATABASE_URL=${db}_e2e E2E_PORT=${port}
export DB_POOL_MAX=5 DB_QUERY_TIMEOUT_MS=10000 LOG_LEVEL=warn ENABLE_TEST_ROUTES=false LLM_PROVIDER=mock
export E2E_WEBKIT=\${E2E_WEBKIT:-0}
EOF
# shellcheck disable=SC1090
source "$envfile"
echo "agent-env: node $(node -v), worktree $(pwd)"
pnpm install --frozen-lockfile --prefer-offline --reporter=silent
DB_NAMES="coach_${slug}_dev coach_${slug}_test coach_${slug}_e2e" pnpm -s db:setup >/dev/null
pnpm -s db:migrate >/dev/null
pnpm -s exec svelte-kit sync >/dev/null
echo "agent-env: ready. Prefix every command with: source $envfile &&"
