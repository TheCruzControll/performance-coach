#!/usr/bin/env bash
# A local PostgreSQL 18.6 (CI's postgres:18 image and the Neon production branch run 18), beside
# the shared Postgres 16 on 5432, which it never touches. Idempotent; run as root.
#
#   pg18                      start it unless it is running, wait until ready, print the port
#   pg18 coach_x_test ...     also ensure role coach/coach (LOGIN CREATEDB) and these databases,
#                             owned by coach (drop/recreate them yourself if you need them fresh)
#   pg18 stop                 stop it (only if nothing else is using it)
#
# Then: TEST_DATABASE_URL=postgres://coach:coach@localhost:5433/coach_x_test pnpm test:integration
# Superuser: postgres/postgres (PGADMIN_URL=postgres://postgres:postgres@localhost:5433/postgres,
# which `pnpm db:setup` also accepts). Built from the Ubuntu archive's verified 18.6 source into
# /var/lib/pg18 (install/, data/, run/ = unix socket dir, log/server.log), run by system user pg18
# (initdb refuses root; the scratchpad tree is root-only, so the cluster lives outside it).
set -euo pipefail

HOME_DIR=/var/lib/pg18
BIN="$HOME_DIR/install/bin"
DATA="$HOME_DIR/data"
PORT=5433
export PGPASSWORD=postgres

as_pg18() { (cd / && runuser -u pg18 -- "$@"); }
ready() { "$BIN/pg_isready" -q -h localhost -p "$PORT" -U postgres -d postgres; }
psql_admin() { "$BIN/psql" -X -q -v ON_ERROR_STOP=1 -h localhost -p "$PORT" -U postgres -d postgres "$@"; }

[[ ${EUID} -eq 0 ]] || { echo "pg18: run as root (it starts the server as user pg18)" >&2; exit 1; }
[[ -x "$BIN/postgres" && -f "$DATA/PG_VERSION" ]] || {
	echo "pg18: no cluster at $DATA (install missing)" >&2
	exit 1
}

if [[ "${1:-}" == stop ]]; then
	if ready; then as_pg18 "$BIN/pg_ctl" -D "$DATA" -m fast -w stop; else echo "pg18: not running"; fi
	exit 0
fi

# One starter at a time; later callers wait, then find it ready.
exec 9>"$HOME_DIR/start.lock"
flock -w 120 9
if ! ready; then
	as_pg18 "$BIN/pg_ctl" -D "$DATA" -l "$HOME_DIR/log/server.log" -w -t 60 start >/dev/null
fi
for _ in $(seq 1 60); do ready && break; sleep 1; done
ready || { echo "pg18: not ready; see $HOME_DIR/log/server.log" >&2; exit 1; }

if (($#)); then
	psql_admin <<'SQL'
SELECT 'CREATE ROLE coach LOGIN CREATEDB PASSWORD ''coach'''
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'coach') \gexec
ALTER ROLE coach WITH LOGIN CREATEDB PASSWORD 'coach';
SQL
	for db in "$@"; do
		[[ "$db" =~ ^[a-z0-9_]+$ ]] || { echo "pg18: bad database name '$db'" >&2; exit 2; }
		psql_admin -v "db=$db" <<'SQL'
SELECT format('CREATE DATABASE %I OWNER coach', :'db')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db') \gexec
SQL
	done
fi
flock -u 9
echo "$PORT"
