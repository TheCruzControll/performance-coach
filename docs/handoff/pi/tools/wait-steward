#!/bin/bash
# Re-run steward-plan every 3 minutes; exit (printing the plan) when a PR is READY, a PR's CI failed,
# or the set of open PRs changes.
S=/Users/franciscruz/playground/pc-scratch
cd $S
prev=""
while true; do
  out=$(REPO_DIR=/Users/franciscruz/playground/performance-coach timeout 150 $S/bin/steward-plan 2>&1)
  prs=$(grep -o '^#[0-9]*' <<<"$out" | sort | tr '\n' ' ')
  if grep -qE '^ACTION|READY|fail|error|cancel' <<<"$out" || { [ -n "$prev" ] && [ "$prs" != "$prev" ]; }; then
    echo "$out"; exit 0
  fi
  prev=$prs
  sleep 180
done
